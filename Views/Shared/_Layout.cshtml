@using PIV11.Infrastructure
@{

    // Flags each view can set (via ViewBag) before rendering this layout:
    //   ViewBag.ActiveScreen : "Home" | "Product Info" | "Edit" | "My People" | "Recent"
    //   ViewBag.ShowBack     : true to show the back arrow in the header
    //   ViewBag.ShowSave     : true to show the save icon in the header
    //   ViewBag.SaveFormId   : the id of the <form> the save icon should submit
        // Banderas que cada vista puede establecer (a través de ViewBag) antes de renderizar este diseño:
        //  ViewBag.ActiveScreen : "Home" | "Product Info" | "Edit" | "My People" | "Recent"
        // ViewBag.ShowBack     : true para mostrar la flecha de retroceso en el encabezado
        // ViewBag.ShowSave     : true para mostrar el icono de guardar en el encabezado
        // ViewBag.SaveFormId   : el id del <form> que el icono de guardar debe enviar

    string activeScreen = ViewBag.ActiveScreen as string ?? "";
    bool showBack = ViewBag.ShowBack ?? false;
    bool showSave = ViewBag.ShowSave ?? false;
    string saveFormId = ViewBag.SaveFormId as string ?? "";

    bool isLoggedIn = SessionHelper.IsLoggedIn;
    bool isEmployee = SessionHelper.IsEmployee;
    bool isAdmin = SessionHelper.IsAdmin;
    bool isShopper = SessionHelper.IsShopper;
    bool canAccessMyPeople = SessionHelper.CanAccessMyPeople;

    // "Product Info" nav link / back arrow both need to know which product was last viewed - tracked centrally in SessionHelper.
    // Navigating to a product page sets this value; navigating away (to Home, My People, etc.) does not clear it, so the back arrow can still return to the last product viewed.
        // Nav link "Product info" y el botón de retroceso necesitan saber qué producto se vio por última vez; se rastrea de manera central en SessionHelper.
        // Navegar a una página de producto establece este valor; navegar a otra página (Inicio, My People, etc.) no lo borra, por lo que el botón de retroceso aún puede regresar al último producto visto.
    decimal? currentUpcObj = SessionHelper.CurrentProductUPC;

    // UPC is a decimal, but we don't want to show the decimal point in the URL. So we convert it to a string without any decimal places.
        // UPC es un decimal, pero no queremos mostrar el punto decimal en la URL. Por lo tanto, lo convertimos a una cadena sin decimales.
    bool hasCurrentProduct = currentUpcObj.HasValue;

    // Header background tint: violet for admin, emerald for employee, blue for shopper, slate for guest.
    // (CSS class stays named "header-user" - a harmless internal detail, not shown to anyone - even though the role is now called "shopper"/"employee"/"admin".)


    string headerClass = isAdmin ? "site-header header-admin"
                        : isEmployee ? "site-header header-user"
                        : isShopper ? "site-header header-shopper"
                        : "site-header header-guest";

    // Friendly role label for the header pill ("John | Employee").
    string roleLabel = isAdmin ? "Admin" : isEmployee ? "Employee" : isShopper ? "Shopper" : "";

    // Where the back arrow should go. Most screens go back to Home; Edit
    // and Edit History explicitly opt into going back to Product Info
    // instead by setting ViewBag.BackToProductInfo = true.
    bool backToProductInfo = ViewBag.BackToProductInfo ?? false;
    string backUrl = backToProductInfo && hasCurrentProduct
        ? Url.Action("Info", "Product", new { upc = currentUpcObj.Value })
        : Url.Action("Index", "Home");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - FoodScan</title>
    <link href="~/Content/site.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible&family=Lexend:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    @* Applying every saved accessibility choice as early as possible avoids a
        flash of un-adjusted content before site.js finishes loading. *@
    <script>
        (function () {
            var html = document.documentElement;

            // Dark mode: an explicit saved choice always wins. If the person
            // has never touched the toggle, follow the browser/OS setting
            // instead (prefers-color-scheme) so the app matches their system
            // automatically until they override it.
            var darkPref = localStorage.getItem('foodscan-dark');
            var systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (darkPref === 'true' || (darkPref === null && systemPrefersDark)) {
                html.classList.add('dark');
            }

            if (localStorage.getItem('foodscan-contrast') === 'true') html.classList.add('high-contrast');
            if (localStorage.getItem('foodscan-motion') === 'true') html.classList.add('reduce-motion');
            if (localStorage.getItem('foodscan-highlight-headings') === 'true') html.classList.add('highlight-headings');
            if (localStorage.getItem('foodscan-highlight-links') === 'true') html.classList.add('highlight-links');

            var fontChoice = localStorage.getItem('foodscan-font') || 'default';
            if (fontChoice === 'atkinson') html.classList.add('font-atkinson');
            else if (fontChoice === 'opendyslexic') html.classList.add('font-opendyslexic');

            var fontSize = localStorage.getItem('foodscan-fontsize') || '100';
            html.style.setProperty('--font-size', fontSize === '150' ? '24px' : fontSize === '200' ? '32px' : '16px');

            var spacing = localStorage.getItem('foodscan-spacing') || 'normal';
            html.style.setProperty('--letter-spacing', spacing === 'wide' ? '0.05em' : spacing === 'wider' ? '0.1em' : 'normal');

            var lineHeight = localStorage.getItem('foodscan-lineheight') || 'normal';
            html.style.setProperty('--line-height-base', lineHeight === 'relaxed' ? '1.8' : lineHeight === 'loose' ? '2.1' : '1.5');
        })();
    </script>
</head>

@*
    Header logic: determine which nav pill is active, whether to show the back arrow, and where it should go.
    The back arrow usually goes to Home, but Edit and Edit History explicitly opt into going back to Product Info instead.
    The save icon is only shown on screens that have a form to submit (Edit, My People form, etc.).
    The save icon is a <button type="submit"> that submits the form with the id specified in ViewBag.SaveFormId.
*@

<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="@headerClass">
        <div class="header-inner">
            <div class="header-left">
                @if (showBack)
                {
                    <a href="@backUrl" class="icon-btn" aria-label="Go back">&#8592;</a>
                }
                <a href="@Url.Action("Index", "Home")" class="brand-logo" aria-label="FoodScan home">
                    Food<span class="brand-accent">Scan</span>
                </a>
            </div>

            <div class="header-right">
                <nav class="nav-pills" aria-label="Main navigation">
                    <a href="@Url.Action("Index", "Home")"
                       class="nav-pill @(activeScreen == "Home" ? "nav-pill-active" : "")">Home</a>

                    @if (hasCurrentProduct)
                    {
                        <a href="@Url.Action("Info", "Product", new { upc = currentUpcObj.Value })"
                           class="nav-pill @((activeScreen == "Product Info" || activeScreen == "Edit") ? "nav-pill-active" : "")">Product Info</a>
                    }
                    else
                    {
                        <span class="nav-pill nav-pill-disabled">Product Info</span>
                    }

                    @if (canAccessMyPeople)
                    {
                        <a href="@Url.Action("Index", "People")"
                           class="nav-pill @(activeScreen == "My People" ? "nav-pill-active" : "")">My People</a>
                    }
                </nav>

                <span class="header-divider"></span>

                <button type="button" id="darkModeToggle" class="icon-btn" aria-label="Switch to dark mode">
                    <span id="darkModeIcon" aria-hidden="true">&#9789;</span>
                </button>

                @if (showSave)
                {
                    <button type="submit" form="@saveFormId" class="icon-btn icon-btn-primary" aria-label="Save changes">&#128190;</button>
                }

                @if (isLoggedIn)
                {
                    <div class="user-menu-wrapper">
                        <button type="button" id="userMenuToggle" class="user-pill user-pill-button"
                                aria-haspopup="true" aria-expanded="false" aria-controls="userMenu">
                            @SessionHelper.CurrentDisplayName <span class="user-pill-role">| @roleLabel</span>
                            <span class="user-menu-kebab" aria-hidden="true">&#8942;</span>
                        </button>
                        <div id="userMenu" class="user-menu" hidden role="menu">
                            <a href="@Url.Action("ChangeDisplayName", "Account")" class="user-menu-item" role="menuitem">Change Name</a>
                            <a href="@Url.Action("ChangePassword", "Account")" class="user-menu-item" role="menuitem">Change Password</a>
                        </div>
                    </div>
                    <a href="@Url.Action("Logout", "Account")" class="icon-btn" aria-label="Log out">&#8594;|</a>
                }
                @* Mobile menu toggle - the menu itself reuses the same links as the desktop nav pills *@
                <div class="mobile-menu-wrapper">
                    <button type="button" id="mobileMenuToggle" class="icon-btn mobile-only" aria-label="Open navigation menu" aria-expanded="false">&#8942;</button>
                    <div id="mobileMenu" class="mobile-menu" hidden>
                        <a href="@Url.Action("Index", "Home")" class="mobile-menu-item">Home</a>
                        @if (hasCurrentProduct)
                        {
                            <a href="@Url.Action("Info", "Product", new { upc = currentUpcObj.Value })" class="mobile-menu-item">Product Info</a>
                        }
                        @if (canAccessMyPeople)
                        {
                            <a href="@Url.Action("Index", "People")" class="mobile-menu-item">My People</a>
                        }
                        @if (isLoggedIn)
                        {
                            <a href="@Url.Action("ChangeDisplayName", "Account")" class="mobile-menu-item">Change Name</a>
                        }
                        <a href="@Url.Action("ChangeDisplayName", "Account")" class="mobile-menu-item">Change Name</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    @* Accessibility panel - shared markup, present on every page *@
    @Html.Partial("_AccessibilityPanel")

    <script src="~/Scripts/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
