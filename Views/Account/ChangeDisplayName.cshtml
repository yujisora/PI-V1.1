@using PIV11.Infrastructure
@{
    ViewBag.ActiveScreen = "";
    ViewBag.Title = "Change Name";
}

<div class="page-container-narrow">
    <div class="card">
        <h2>Change Name</h2>
        <p class="text-muted" style="margin-bottom: 1rem;">This is what shows in the header instead of your username - e.g. "Juan | Employee".</p>

        @Html.ValidationSummary(false, "", new { @class = "form-error", role = "alert" })

        @if (TempData["NameChangedMessage"] != null)
        {
            <p class="form-error" role="status" style="color: var(--primary-solid);">@TempData["NameChangedMessage"]</p>
        }

        @using (Html.BeginForm("ChangeDisplayName", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <label class="field-label" for="displayName">Name</label>
            <input type="text" id="displayName" name="displayName" class="field-input"
                   value="@SessionHelper.CurrentDisplayName" placeholder="e.g. Juan" title="Your display name" aria-describedby="displayNameHint" />
            <p id="displayNameHint" class="field-hint">Leave blank to just show your username instead.</p>

            <button type="submit" class="btn-primary" style="margin-top: 1.5rem;">Save Name</button>
        }
    </div>
</div>
