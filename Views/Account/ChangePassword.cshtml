@{
    ViewBag.ActiveScreen = "";
    ViewBag.Title = "Change Password";
}

<div class="page-container-narrow">
    <div class="card">
        <h2>Change Password</h2>
        <p class="text-muted" style="margin-bottom: 1rem;">Update the password for your own account.</p>

        @Html.ValidationSummary(false, "", new { @class = "form-error", role = "alert" })

        @if (TempData["PasswordChangedMessage"] != null)
        {
            <p class="form-error" role="status" style="color: var(--primary-solid);">@TempData["PasswordChangedMessage"]</p>
        }

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <label class="field-label" for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" class="field-input"
                   placeholder="Enter your current password" title="Your current password" />

            <label class="field-label" for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" class="field-input"
                   placeholder="Choose a new password" title="Your new password" />

            <label class="field-label" for="confirmNewPassword">Confirm New Password</label>
            <input type="password" id="confirmNewPassword" name="confirmNewPassword" class="field-input"
                   placeholder="Type it again" title="Confirm your new password" />

            <button type="submit" class="btn-primary" style="margin-top: 1.5rem;">Update Password</button>
        }
    </div>
</div>
