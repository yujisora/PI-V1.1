@{
    Layout = null;
    ViewBag.Title = "Privacy Policy - FoodScan";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/site.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible&family=Lexend:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    <script>
        (function () {
            var html = document.documentElement;
            var darkPref = localStorage.getItem('foodscan-dark');
            var systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (darkPref === 'true' || (darkPref === null && systemPrefersDark)) html.classList.add('dark');

            if (localStorage.getItem('foodscan-contrast') === 'true') html.classList.add('high-contrast');
            if (localStorage.getItem('foodscan-motion') === 'true') html.classList.add('reduce-motion');
            if (localStorage.getItem('foodscan-highlight-headings') === 'true') html.classList.add('highlight-headings');
            if (localStorage.getItem('foodscan-highlight-links') === 'true') html.classList.add('highlight-links');

            var fontChoice = localStorage.getItem('foodscan-font') || 'default';
            if (fontChoice === 'atkinson') html.classList.add('font-atkinson');
            else if (fontChoice === 'opendyslexic') html.classList.add('font-opendyslexic');

            var fontSize = localStorage.getItem('foodscan-fontsize') || '100';
            html.style.setProperty('--font-size', fontSize === '150' ? '24px' : fontSize === '200' ? '32px' : '16px');

            var spacing = localStorage.getItem('foodscan-spacing') || 'normal';
            html.style.setProperty('--letter-spacing', spacing === 'wide' ? '0.05em' : spacing === 'wider' ? '0.1em' : 'normal');

            var lineHeight = localStorage.getItem('foodscan-lineheight') || 'normal';
            html.style.setProperty('--line-height-base', lineHeight === 'relaxed' ? '1.8' : lineHeight === 'loose' ? '2.1' : '1.5');
        })();
    </script>
</head>
<body class="login-body">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="login-top-actions">
        <button type="button" id="darkModeToggle" class="floating-icon-btn" aria-label="Switch to dark mode">
            <span id="darkModeIcon" aria-hidden="true">&#9789;</span>
        </button>
    </div>

    <main id="main-content" class="login-wrapper">
        <div class="login-card policy-card">

            <div class="login-header">
                <h1 class="brand-logo">Food<span class="brand-accent">Scan</span></h1>
                <p class="login-subtitle">Privacy Policy</p>
            </div>

            <div class="policy-body">
                <p class="text-muted" style="margin-bottom: 1.25rem;">Last updated: 2026.</p>

                <h3>What we collect</h3>
                <p>When you create an account, we store the username and password you choose, along with any optional display name or member ID you provide. If you use My People, we store the names and allergen profiles of the people you add - this data is scoped to your account only and is never shown to any other account.</p>

                <h3>How we use it</h3>
                <p>Your account information is used solely to let you log in, identify who proposed a given product edit (visible to admin during review), and personalize your own My People allergy checks. We do not sell, share, or use your data for advertising of any kind.</p>

                <h3>Search history</h3>
                <p>Recently viewed products are kept only in your browser session, not saved permanently to our database. This list clears automatically when you log out.</p>

                <h3>Account deletion</h3>
                <p>If your account is deleted, your own My People data is deleted along with it. Product edits you've made stay on record as part of the product's edit history, identified by your username, so the history of what changed on a product remains accurate even after an account is removed.</p>

                <h3>Contact</h3>
                <p>Questions about this policy can be directed to the site administrator.</p>
            </div>

            <div class="login-footer">
                <a href="@Url.Action("Index", "Home")" class="link-button-block">Back</a>
            </div>

        </div>
    </main>

    @Html.Partial("_AccessibilityPanel")

    <script src="~/Scripts/site.js"></script>
</body>
</html>
