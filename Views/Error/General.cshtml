@{
    Layout = null;
    ViewBag.Title = "Something Went Wrong - FoodScan";
}

@*
    Used for any error (HTTP 500); catch-all page, returns to home page.
    Usada para cualquer error (HTTP 500); página default de error, regresa a la página principal.
*@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/site.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible&family=Lexend:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    <script>
        (function () {
            var html = document.documentElement;
            var darkPref = localStorage.getItem('foodscan-dark');
            var systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (darkPref === 'true' || (darkPref === null && systemPrefersDark)) html.classList.add('dark');
        })();
    </script>
</head>
<body class="login-body">
    <main class="login-wrapper">
        <div class="login-card" style="text-align: center;">
            <div class="login-header">
                <h1 class="brand-logo">Food<span class="brand-accent">Scan</span></h1>
            </div>
            <p style="font-size: 3rem; margin: 0.5rem 0;" aria-hidden="true">&#9888;</p>
            <h2 style="font-size: 1.3rem; margin-bottom: 0.5rem;">Something went wrong</h2>
            <p class="text-muted" style="margin-bottom: 1.5rem;">
                An unexpected error occurred while handling your request. Nothing was saved incorrectly &ndash;
                you can safely go back and try again.
            </p>
            <a href="@Url.Action("Index", "Home")" class="btn-primary btn-full btn-large">Back to Home</a>
        </div>
    </main> 
</body>
</html>
